{
  "name": "myst-tattoo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Myst Tattoo Studio API (Express + MongoDB/Mongoose)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:demo": "node src/scripts/seed-demo.js",
    "db:copy": "node src/scripts/copy-db.js",
    "photos:to-blob": "node src/scripts/photos-to-blob.js",
    "photos:to-site": "node src/scripts/photos-to-site.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
