# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (local default). For Atlas use:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/myst-tattoo
MONGODB_URI=mongodb://127.0.0.1:27017/myst-tattoo

# Allowed frontend origin(s) for CORS, comma-separated
CLIENT_ORIGIN=http://localhost:3000

# Admin panel (/admin on the site). One password opens it.
# Use a long, hard-to-guess password; sign-in is switched off while either value is empty.
ADMIN_PASSWORD=
# Signs the admin session cookie. Any long random string, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Folder for uploaded photos, relative to this folder
UPLOAD_DIR=uploads

# Vercel Blob. Leave empty to keep photos in the folder above. On Vercel the
# connected store identifies itself (BLOB_STORE_ID) and this is not needed; set
# it here only to move existing photos there (npm run photos:to-blob).
# See ../DEPLOY.md.
BLOB_READ_WRITE_TOKEN=
