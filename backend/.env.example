# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (local default). For Atlas use:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/myst-tattoo
MONGODB_URI=mongodb://127.0.0.1:27017/myst-tattoo

# Allowed frontend origin(s) for CORS, comma-separated
CLIENT_ORIGIN=http://localhost:3000
