# WhatsApp number in international format, digits only (no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=995599210185

# Backend API base URL. The site reads artists and tattoos from it and
# forwards /api and /uploads to it. On Vercel: the backend project's address,
# e.g. https://myst-tattoo-api.vercel.app (see ../DEPLOY.md).
API_URL=http://localhost:5000

# ----- Google Maps: the map and the reviews on the home page -----
# Leave these empty and the home page simply has no "Reviews & Location" section.
#
# The Google Cloud project behind these keys needs a billing account, and the
# keys must be made after it was added. A key made before (Google calls it a
# "Maps Demo Key") still draws the map and returns the rating, but Google
# leaves out the reviews themselves and the section shows no review cards.
#
# Server key for the Places API (New): reads the studio's rating and reviews.
# Secret: never give it a NEXT_PUBLIC_ name. In Google Cloud, restrict it to
# "Places API (New)" only.
GOOGLE_PLACES_API_KEY=
# The studio's place ID on Google Maps, e.g. ChIJN1t_tDeuEmsRUsoyG83frY4
# Find it at https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=
# Browser key for the Maps JavaScript API: draws the map. Visible to visitors,
# so in Google Cloud restrict it to this site's addresses (and localhost) and
# to "Maps JavaScript API" only. Without it the section shows the address and
# a link to Google Maps where the map would be.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: a map ID whose style was made in Google Cloud (Map Styles). Without
# it the map wears the dark style built into components/StudioMap.tsx.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
